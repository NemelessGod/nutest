{
  "name": "jokers-abyss",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --import tsx --test tests/*.test.js tests/abyss/*.test.ts",
    "typecheck": "tsc --noEmit",
    "simulate": "node --import tsx scripts/simulate-abyss.ts",
    "test:e2e": "playwright test",
    "profile": "node scripts/profile.js"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.1.9"
  }
}
